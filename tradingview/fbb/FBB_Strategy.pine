//@version=6
// ============================================================================
// First Bullish Bounce (FBB) — swing-trading research strategy, v1.0
// Market: NSE equities, 1D standard candles only.
//
// Purpose: test whether the setup has a measurable historical edge. It is NOT
// evidence of profitability and does not reproduce real execution exactly.
//
// Flow:  completed reversal candle -> READY (stop-limit buy order resting at
//        trigger, capped at a max entry price that still meets min R:R)
//        -> TRIGGERED / OPEN (fill on a LATER session) -> CLOSED (TP / SL / TIME)
//        or -> EXPIRED (timeout, gap above max entry, or low broke the stop).
//
// No request.security(), no lookahead, no future bars. Signals use only the
// completed signal candle and earlier data. Orders placed at the signal
// candle's close can only fill from the next session onwards
// (process_orders_on_close = false).
// ============================================================================
strategy(title = "First Bullish Bounce (FBB) v1.0", shorttitle = "FBB", overlay = true,
     initial_capital = 1000000, default_qty_type = strategy.cash, default_qty_value = 100000,
     pyramiding = 0, margin_long = 100, margin_short = 100,
     commission_type = strategy.commission.percent, commission_value = 0.12, slippage = 2,
     process_orders_on_close = false, calc_on_order_fills = false, calc_on_every_tick = false,
     use_bar_magnifier = false, fill_orders_on_standard_ohlc = true,
     backtest_fill_limits_assumption = 1, max_labels_count = 500)

// ───────────────────────────── Inputs ─────────────────────────────
grpW = "Backtest window (gates NEW setups only)"
startTime = input.time(timestamp("01 Jan 2012 00:00 +0530"), "Start date", group = grpW)
endTime   = input.time(timestamp("31 Dec 2099 00:00 +0530"), "End date", group = grpW)

grpT = "1. Trend"
emaFastLen     = input.int(20, "Fast EMA length", minval = 1, group = grpT)
emaMidLen      = input.int(50, "Trend EMA length", minval = 1, group = grpT)
emaSlowLen     = input.int(200, "Long EMA length", minval = 1, group = grpT)
useEmaStack    = input.bool(true, "Require trend EMA > long EMA (50 > 200)", group = grpT)
useEstablished = input.bool(true, "Require established uptrend before reversal", group = grpT)
trendLen       = input.int(20, "  Lookback (sessions)", minval = 2, group = grpT)
minPctAbove    = input.float(70.0, "  Min % of prior closes above trend EMA", minval = 0, maxval = 100, group = grpT)
useAdx         = input.bool(false, "Use ADX filter", group = grpT)
adxLen         = input.int(14, "  ADX length", minval = 1, group = grpT)
adxMin         = input.float(20.0, "  Min ADX", minval = 0, group = grpT)

grpP = "2. Pullback / support"
pbMode    = input.string("20 or 50 EMA", "Pullback reference",
     options = ["20 EMA", "50 EMA", "20 or 50 EMA", "Swing-low support", "EMA or support"], group = grpP)
pbTolPct  = input.float(1.5, "Touch tolerance (± % around level)", minval = 0, step = 0.1, group = grpP)
pivLeft   = input.int(5, "Swing low: left bars", minval = 1, group = grpP)
pivRight  = input.int(5, "Swing low: right bars (confirmation delay)", minval = 1, group = grpP)
supMaxAge = input.int(60, "Swing low: max age (sessions)", minval = 1, group = grpP)

grpC = "3. Reversal candle"
minBodyPct  = input.float(50.0, "Min real body (% of range)", minval = 0, maxval = 100, group = grpC)
closeTopPct = input.float(25.0, "Close within top X% of range", minval = 0, maxval = 100, group = grpC)
volMult     = input.float(1.2, "Min volume vs average (x)", minval = 0, step = 0.1, group = grpC)
volLen      = input.int(20, "Volume average length (prior sessions)", minval = 1, group = grpC)
missingVol  = input.string("Reject signal", "If volume is missing / zero",
     options = ["Reject signal", "Skip volume check"], group = grpC)

grpE = "4. Entry"
trigBufPct = input.float(0.10, "Trigger buffer above reversal high (%)", minval = 0, step = 0.05, group = grpE)
expiryBars = input.int(3, "Setup expiry (sessions)", minval = 1, group = grpE)

grpS = "5. Stop-loss"
stopBufType = input.string("Percent", "Stop buffer type", options = ["Percent", "ATR"], group = grpS)
stopBufPct  = input.float(0.10, "  Percent buffer below reversal low (%)", minval = 0, step = 0.05, group = grpS)
atrLen      = input.int(14, "  ATR length", minval = 1, group = grpS)
atrMult     = input.float(0.10, "  ATR buffer multiple", minval = 0, step = 0.05, group = grpS)
maxStopPct  = input.float(3.0, "Max stop distance (% of entry)", minval = 0.1, maxval = 50, step = 0.1, group = grpS)

grpX = "6. Target / exit"
tgtPct  = input.float(5.0, "Target (%)", options = [3.0, 5.0, 7.0], group = grpX)
minRR   = input.float(2.5, "Min planned reward:risk", minval = 0.1, step = 0.1, group = grpX)
maxHold = input.int(10, "Max holding period (sessions, entry day = 1)", minval = 1, group = grpX)

grpD = "Display"
showEmas    = input.bool(true, "Plot EMAs", group = grpD)
showLevels  = input.bool(true, "Plot trigger / stop / target", group = grpD)
showLabels  = input.bool(true, "Show state labels", group = grpD)
showRejects = input.bool(true, "Mark candles rejected on R:R / stop distance", group = grpD)
showTable   = input.bool(true, "Show status table", group = grpD)

// ───────────────────────────── Guards ─────────────────────────────
if not chart.is_standard
    runtime.error("FBB: use a standard candlestick/bar chart, not Heikin-Ashi, Renko or other synthetic types.")
if not (timeframe.isdaily and timeframe.multiplier == 1)
    runtime.error("FBB: designed for the 1D timeframe only.")

// ───────────────────────────── Helpers ────────────────────────────
// The tiny epsilon stops float noise (e.g. 2000.0000001) from moving a level by a whole tick.
roundUp(float x) =>
    math.ceil(x / syminfo.mintick - 1e-9) * syminfo.mintick
roundDn(float x) =>
    math.floor(x / syminfo.mintick + 1e-9) * syminfo.mintick

// Low within ±tolerance of the level and close back at/above it.
touches(float level) =>
    lo = level * (1.0 - pbTolPct / 100.0)
    hi = level * (1.0 + pbTolPct / 100.0)
    not na(level) and low <= hi and low >= lo and close >= level

// ─────────────────────── Indicators (every bar) ───────────────────
emaFast = ta.ema(close, emaFastLen)
emaMid  = ta.ema(close, emaMidLen)
emaSlow = ta.ema(close, emaSlowLen)
atrVal  = ta.atr(atrLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
volSma   = ta.sma(volume, volLen)
volAvg   = volSma[1]                                    // average of PRIOR sessions only
aboveCnt = math.sum(close > emaMid ? 1.0 : 0.0, trendLen)
pivLow   = ta.pivotlow(low, pivLeft, pivRight)          // reported only after pivRight bars: no lookahead

// Most recent CONFIRMED swing low.
var float supLevel = na
var int   supBar   = na
if not na(pivLow)
    supLevel := pivLow
    supBar   := bar_index - pivRight
supValid = not na(supLevel) and bar_index - supBar <= supMaxAge

// ───────────────────────────── Rules ──────────────────────────────
// 1. Trend
trendOk       = close > emaMid
emaStackOk    = not useEmaStack or emaMid > emaSlow
establishedOk = not useEstablished or (emaMid[1] > emaMid[1 + trendLen] and aboveCnt[1] / trendLen * 100.0 >= minPctAbove)
adxOk         = not useAdx or adxVal >= adxMin

// 2. Pullback
touch20     = touches(emaFast)
touch50     = touches(emaMid)
touchSupRaw = touches(supLevel)
touchSup    = supValid and touchSupRaw
pullbackOk = switch pbMode
    "20 EMA"            => touch20
    "50 EMA"            => touch50
    "20 or 50 EMA"      => touch20 or touch50
    "Swing-low support" => touchSup
    => touch20 or touch50 or touchSup

// 3. Reversal candle
rng        = high - low
body       = close - open
candleOk   = rng > 0 and close > open and body >= rng * minBodyPct / 100.0 and high - close <= rng * closeTopPct / 100.0
volMissing = na(volume) or volume <= 0 or na(volAvg) or volAvg <= 0
volOk      = volMissing ? missingVol == "Skip volume check" : volume >= volMult * volAvg

inWindow = time >= startTime and time <= endTime
reversal = barstate.isconfirmed and inWindow and trendOk and emaStackOk and establishedOk and adxOk and pullbackOk and candleOk and volOk

// 4–6. Candidate levels from the signal candle
tgtFrac      = tgtPct / 100.0
stopBuf      = stopBufType == "ATR" ? atrMult * atrVal : low * stopBufPct / 100.0
candTrigger  = math.max(roundUp(high * (1.0 + trigBufPct / 100.0)), high + syminfo.mintick)
candStop     = roundDn(low - stopBuf)
// Highest fill price that still satisfies BOTH the max stop distance and the min R:R
// (R:R falls as entry rises because the stop is fixed): entry <= stop*RR/(RR - target).
candMaxEntry = roundDn(math.min(candStop / (1.0 - maxStopPct / 100.0), candStop * minRR / (minRR - tgtFrac)))
candTarget   = math.round_to_mintick(candTrigger * (1.0 + tgtFrac))
candRiskPct  = (candTrigger - candStop) / candTrigger * 100.0
candRR       = (candTarget - candTrigger) / (candTrigger - candStop)
// The stop is never moved to make a setup pass: a setup that fails at its trigger price is rejected.
candAccept   = not na(candStop) and candStop > 0 and candTrigger <= candMaxEntry

// ───────────────────────────── State ──────────────────────────────
// state: 0 = IDLE, 1 = READY, 2 = OPEN.  TRIGGERED / EXPIRED / CLOSED are transition events.
var int    state      = 0
var string lastEvent  = "—"
var int    setupBar   = na
var float  trigPx     = na
var float  stopPx     = na
var float  maxEntryPx = na
var float  tgtPx      = na
var float  entryPx    = na
var int    entryBar   = na
var int    lastTotal  = 0
var int    lastClosed = 0

var int nCandidates = 0
var int nRejected   = 0
var int nTriggered  = 0
var int nExpTime    = 0
var int nExpGap     = 0
var int nExpBroke   = 0
var int nTP         = 0
var int nSL         = 0
var int nTime       = 0

stateAtOpen  = state
eventThisBar = false
rejectedNow  = false
dateStr      = str.format_time(time, "yyyy-MM-dd", syminfo.timezone)

// A) Entry filled during this session (order was placed on an EARLIER bar's close).
totalTrades = strategy.opentrades + strategy.closedtrades
newEntry    = totalTrades > lastTotal
lastTotal  := totalTrades
if newEntry
    nTriggered   += 1
    eventThisBar := true
    entryBar     := bar_index
    entryPx      := strategy.position_size > 0 ? strategy.opentrades.entry_price(0) : strategy.closedtrades.entry_price(strategy.closedtrades - 1)
    lastEvent    := "TRIGGERED " + dateStr
    if showLabels
        label.new(bar_index, low, "TRIGGERED\n" + str.tostring(entryPx, format.mintick), yloc = yloc.belowbar,
             style = label.style_label_up, color = color.green, textcolor = color.white, size = size.small,
             tooltip = "Entry " + str.tostring(entryPx, format.mintick) + " | trigger " + str.tostring(trigPx, format.mintick))
    if strategy.position_size > 0
        state := 2
        // Re-base the target on the ACTUAL fill price. Takes effect from the next session;
        // on the fill session itself the pre-placed planned target applies.
        tgtPx := math.round_to_mintick(entryPx * (1.0 + tgtFrac))
        strategy.exit("FBB-X", from_entry = "FBB", stop = stopPx, limit = tgtPx, comment_profit = "TP", comment_loss = "SL")
    else
        state := 0   // entered and exited inside the same session

// B) Trades closed (TP / SL intrabar, or TIME at a previous close). Labels go on the actual exit bar.
closedNow = strategy.closedtrades
if closedNow > lastClosed
    for i = lastClosed to closedNow - 1
        ep  = strategy.closedtrades.entry_price(i)
        xp  = strategy.closedtrades.exit_price(i)
        xb  = strategy.closedtrades.exit_bar_index(i)
        why = strategy.closedtrades.exit_comment(i)
        pct = (xp / ep - 1.0) * 100.0
        if why == "TP"
            nTP += 1
        else if why == "SL"
            nSL += 1
        else if why == "TIME"
            nTime += 1
        if xb == bar_index
            eventThisBar := true
        if showLabels
            label.new(xb, high, "CLOSED " + why + "\n" + (pct >= 0 ? "+" : "") + str.tostring(pct, "0.00") + "%",
                 yloc = yloc.abovebar, style = label.style_label_down, color = pct >= 0 ? color.teal : color.red,
                 textcolor = color.white, size = size.small,
                 tooltip = "Entry " + str.tostring(ep, format.mintick) + " -> exit " + str.tostring(xp, format.mintick) + " (gross, before costs)")
    lastClosed := closedNow
if state == 2 and strategy.position_size == 0
    state        := 0
    eventThisBar := true
    lastEvent    := "CLOSED " + dateStr

// C) Open position: time stop at the close of session maxHold (entry session = 1).
if state == 2 and strategy.position_size > 0
    held = bar_index - entryBar + 1
    if held >= maxHold
        strategy.close("FBB", comment = "TIME", immediately = true)
        strategy.cancel("FBB-X")
        state        := 0
        eventThisBar := true
        lastEvent    := "CLOSED (TIME) " + dateStr

// D) Pending setup: expire / invalidate at this session's close if not filled.
if state == 1
    string reason = ""
    if high >= trigPx
        reason := "GAP"          // trigger traded but no fill at or below max entry
        nExpGap += 1
    else if low < stopPx
        reason := "BROKE LOW"    // stop level traded before the trigger
        nExpBroke += 1
    else if bar_index - setupBar >= expiryBars
        reason := "TIMEOUT"
        nExpTime += 1
    if reason != ""
        strategy.cancel("FBB")
        strategy.cancel("FBB-X")
        state        := 0
        eventThisBar := true
        lastEvent    := "EXPIRED (" + reason + ") " + dateStr
        if showLabels
            label.new(bar_index, high, "EXPIRED\n" + reason, yloc = yloc.abovebar, style = label.style_label_down,
                 color = color.gray, textcolor = color.white, size = size.small)

// E) New setup: only when flat, nothing pending, and no other event on this bar.
if reversal and state == 0 and not eventThisBar and strategy.position_size == 0
    nCandidates += 1
    if candAccept
        state      := 1
        setupBar   := bar_index
        trigPx     := candTrigger
        stopPx     := candStop
        maxEntryPx := candMaxEntry
        tgtPx      := candTarget
        lastEvent  := "READY " + dateStr
        // Stop-limit buy: activates at the trigger, never fills above maxEntryPx.
        strategy.entry("FBB", strategy.long, stop = trigPx, limit = maxEntryPx, comment = "FBB")
        // Exit pre-placed so a stop/target can fill on the entry session itself.
        strategy.exit("FBB-X", from_entry = "FBB", stop = stopPx, limit = tgtPx, comment_profit = "TP", comment_loss = "SL")
        if showLabels
            label.new(bar_index, low, "READY", yloc = yloc.belowbar, style = label.style_label_up,
                 color = color.orange, textcolor = color.black, size = size.small,
                 tooltip = "Trigger " + str.tostring(trigPx, format.mintick) + "\nMax entry " + str.tostring(maxEntryPx, format.mintick) +
                     "\nStop " + str.tostring(stopPx, format.mintick) + "\nPlanned target " + str.tostring(tgtPx, format.mintick) +
                     "\nRisk " + str.tostring(candRiskPct, "0.00") + "% | R:R " + str.tostring(candRR, "0.00"))
    else
        nRejected  += 1
        rejectedNow := true

// ───────────────────────────── Plots ──────────────────────────────
plot(showEmas ? emaFast : na, "Fast EMA", color.new(color.aqua, 0), 1)
plot(showEmas ? emaMid : na, "Trend EMA", color.new(color.orange, 0), 2)
plot(showEmas ? emaSlow : na, "Long EMA", color.new(color.purple, 0), 2)

wasOrIsReady = stateAtOpen == 1 or state == 1
wasOrIsOpen  = stateAtOpen == 2 or state == 2
plot(showLevels and wasOrIsReady ? trigPx : na, "Trigger", color.green, 2, plot.style_linebr)
plot(showLevels and wasOrIsReady ? maxEntryPx : na, "Max entry", color.new(color.green, 60), 1, plot.style_linebr)
plot(showLevels and (wasOrIsReady or wasOrIsOpen) ? stopPx : na, "Stop-loss", color.red, 2, plot.style_linebr)
plot(showLevels and (wasOrIsReady or wasOrIsOpen) ? tgtPx : na, "Target", color.blue, 2, plot.style_linebr)
plot(showLevels and wasOrIsOpen ? entryPx : na, "Entry", color.gray, 1, plot.style_linebr)
bgcolor(wasOrIsOpen ? color.new(color.green, 90) : na, title = "OPEN position")
plotshape(showRejects and rejectedNow, "Rejected (R:R / stop distance)", shape.xcross, location.abovebar, color.new(color.gray, 30), size = size.tiny)

// ───────────────────────────── Table ──────────────────────────────
var table info = table.new(position.top_right, 2, 13, bgcolor = color.new(color.black, 15), border_color = color.gray, border_width = 1)
row(int r, string k, string v, color c) =>
    table.cell(info, 0, r, k, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

if showTable and barstate.islast
    stateTxt = state == 1 ? "READY" : state == 2 ? "OPEN" : "IDLE"
    stateCol = state == 1 ? color.orange : state == 2 ? color.lime : color.silver
    row(0, "State", stateTxt, stateCol)
    row(1, "Last event", lastEvent, color.white)
    row(2, "Trigger / max entry", state == 1 ? str.tostring(trigPx, format.mintick) + " / " + str.tostring(maxEntryPx, format.mintick) : "—", color.white)
    row(3, "Entry", state == 2 ? str.tostring(entryPx, format.mintick) : "—", color.white)
    row(4, "Stop / target", state != 0 ? str.tostring(stopPx, format.mintick) + " / " + str.tostring(tgtPx, format.mintick) : "—", color.white)
    row(5, "Sessions", state == 1 ? "expires in " + str.tostring(expiryBars - (bar_index - setupBar)) : state == 2 ? "held " + str.tostring(bar_index - entryBar + 1) + " / " + str.tostring(maxHold) : "—", color.white)
    row(6, "Target % / min R:R", str.tostring(tgtPct, "0.0") + "% / " + str.tostring(minRR, "0.0"), color.white)
    row(7, "Max risk allowed", str.tostring(math.min(maxStopPct, tgtPct / minRR), "0.00") + "% of entry", color.white)
    row(8, "Qualifying candles (flat)", str.tostring(nCandidates), color.white)
    row(9, "Rejected R:R / stop", str.tostring(nRejected), color.white)
    row(10, "Triggered", str.tostring(nTriggered), color.white)
    row(11, "Expired time / gap / low", str.tostring(nExpTime) + " / " + str.tostring(nExpGap) + " / " + str.tostring(nExpBroke), color.white)
    row(12, "Exits TP / SL / TIME", str.tostring(nTP) + " / " + str.tostring(nSL) + " / " + str.tostring(nTime), color.white)
