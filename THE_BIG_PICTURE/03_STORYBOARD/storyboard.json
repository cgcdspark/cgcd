  {
   "id": "S02",
   "act": "ACT2",
   "title": "The gold rush",
   "lead_in": 0.4,
   "tail": 0.4,
   "vo": [
    {
     "id": "L010",
     "text": "Follow the money, and it starts with four companies.",
     "pause": 0.4
    },
    {
     "id": "L011",
     "text": "In their latest financial years, Microsoft, Alphabet, Amazon and Meta together spent more than four hundred billion dollars on capital expenditure.",
     "pause": 0.35
    },
    {
     "id": "L012",
     "text": "And they are accelerating. Amazon alone expects to spend around two hundred and twenty billion dollars in 2026.",
     "say": "And they are accelerating. Amazon alone expects to spend around two hundred and twenty billion dollars in twenty twenty-six.",
     "pause": 0.4
    },
    {
     "id": "L013",
     "text": "Most of that money pays for one thing: data centres, filled with AI chips.",
     "pause": 0.6
    }
   ],
