  {
   "id": "S04",
   "act": "ACT3",
   "title": "Nvidia",
   "lead_in": 0.4,
   "tail": 0.3,
   "vo": [
    {
     "id": "L030",
     "text": "The most visible winner is Nvidia.",
     "pause": 0.35
    },
    {
     "id": "L031",
     "text": "In the three months to October 2026, it reported revenue of almost one hundred and sixteen billion dollars.",
     "pause": 0.3
    },
    {
     "id": "L032",
     "text": "More than ninety percent of it came from data centres. And it kept roughly seventy-five cents of every dollar as gross profit.",
     "pause": 0.45
    },
    {
     "id": "L033",
     "text": "But Nvidia does not make its own chips. It designs them.",
     "pause": 0.5
    }
   ],
