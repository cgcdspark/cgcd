  {
   "id": "S06",
   "act": "ACT3",
   "title": "Where chip value is captured",
   "lead_in": 0.0,
   "tail": 0.6,
   "vo": [
    {
     "id": "L050",
     "text": "Each link captures value differently.",
     "pause": 0.3
    },
    {
