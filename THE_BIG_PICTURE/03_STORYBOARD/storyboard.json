 "scenes": [
  {
   "id": "S00",
   "act": "ACT1",
   "title": "Cold open",
   "lead_in": 1.2,
   "tail": 0.6,
   "vo": [
    {
     "id": "L001",
     "text": "Every time you ask a chatbot a question, something happens that you never see.",
     "pause": 0.45
    },
    {
     "id": "L002",
     "text": "Somewhere, in a building the size of several football pitches, thousands of chips run a little hotter.",
     "pause": 0.35
    },
    {
     "id": "L003",
     "text": "Pumps push coolant through the racks. And beyond the fence line, a power grid strains to keep up.",
     "pause": 0.6
    },
    {
     "id": "L004",
     "text": "We talk about artificial intelligence as if it were weightless. Software. Code. The cloud.",
     "pause": 0.5
    },
    {
     "id": "L005",
     "text": "But the AI boom runs on concrete, copper, steel and electricity.",
     "pause": 0.5
    },
    {
     "id": "L006",
     "text": "And some of its biggest winners make nothing you would ever call artificial intelligence.",
     "pause": 1.0
    }
   ],
