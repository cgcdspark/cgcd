  {
   "id": "S03",
   "act": "ACT2",
   "title": "The stack",
   "lead_in": 0.2,
   "tail": 0.8,
   "vo": [
    {
     "id": "L020",
     "text": "To see who captures that money, picture AI as a stack.",
     "pause": 0.4
    },
    {
     "id": "L021",
     "text": "At the top, the applications and models. Below them, the chips. Then the factories that make the chips.",
     "pause": 0.3
    },
    {
     "id": "L022",
     "text": "The data centres that house them. The power stations that feed them. The lines and substations that deliver that power.",
     "pause": 0.3
    },
    {
     "id": "L023",
     "text": "And at the very bottom, the transformers, switchgear and cables that make all of it physically possible.",
     "pause": 0.5
    },
    {
     "id": "L024",
     "text": "Most of the attention sits at the top. This story goes all the way down.",
     "pause": 0.8
    }
   ],
   "shots": [
